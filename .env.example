# ── Required ────────────────────────────────────────────────────────────
# Neon Postgres connection string (use the *pooled* one, it contains "-pooler")
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Public URL of the site (no trailing slash) – used in canonical URLs, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://lotterysambad.plus

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password

# Random string (32+ chars) used to sign the admin session cookie
AUTH_SECRET=generate-a-long-random-string-here

# Secret for the scraper endpoint /api/cron/scrape?key=... (also used by Vercel Cron)
CRON_SECRET=another-long-random-string

# ── Optional ────────────────────────────────────────────────────────────
# Vercel Blob token – when set, images are stored in Vercel Blob instead of Postgres
# (Vercel → Storage → Create → Blob → connect to project adds this automatically)
# BLOB_READ_WRITE_TOKEN=

# Local testing only: route source-site requests to the mock server (scripts/dev/mock-sources.mjs)
# SCRAPER_MOCK_ORIGIN=http://localhost:4010
